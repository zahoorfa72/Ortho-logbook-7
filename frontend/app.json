{
  "expo": {
    "name": "Ortho Logbook",
    "slug": "ortho-logbook",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orthologbook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sasims.orthologbook"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.sasims.orthologbook",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 4
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach patient photos from your gallery.",
          "cameraPermission": "Take patient photos with the camera.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Take patient photos with the camera.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sqlite",
        {
          "android": {
            "enableFTS": true
          }
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Ortho Logbook to access patient photos.",
          "savePhotosPermission": "Allow Ortho Logbook to save patient photos to this device."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Scan patient photos, lab reports and paper records with automatic page-edge correction."
        }
      ],
      "./plugins/with-ocr-word-boxes",
      "./plugins/with-drive-background-upload",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Offline-first orthopaedic patient logbook with local records, inventory, statistics and encrypted backup.",
    "newArchEnabled": true
  }
}
