{
  "expo": {
    "name": "Ortho Logbook",
    "slug": "frontend",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.androidnobackend.vm3pwn"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.androidnobackend.vm3pwn",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach patient photos from your gallery.",
          "cameraPermission": "Take patient photos with the camera.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Take patient photos with the camera.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Ortho Logbook to access patient photos.",
          "savePhotosPermission": "Allow Ortho Logbook to save patient photos to this device."
        }
      ],
      "@react-native-google-signin/google-signin",
      "./plugins/with-drive-background-upload"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Offline-first orthopaedic patient logbook with local records, inventory, statistics and encrypted backup."
  }
}
